# PostgreSQL database settings
# Keep POSTGRES_PORT different from 5432 if another PostgreSQL container uses it.
POSTGRES_DB=therapist
POSTGRES_USER=therapist
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_PORT=5433

# Application connection string. Use the same values as above.
DATABASE_URL=postgresql+psycopg://therapist:replace_with_a_secure_password@localhost:5433/therapist

# Optional Webshare proxy settings.
# Leave these blank if you are using proxies.csv instead.
WEBSHARE_PROXY_IP=
WEBSHARE_PROXY_PORT=
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
